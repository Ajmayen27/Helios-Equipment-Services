<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Open_cases_to_dispatchers</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Dispatchers see and update every open case.</description>
        <label>Open cases to dispatchers</label>
        <sharedTo>
            <role>Service_Dispatcher</role>
        </sharedTo>
        <criteriaItems>
            <field>Status</field>
            <operation>notEqual</operation>
            <value>Closed</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
